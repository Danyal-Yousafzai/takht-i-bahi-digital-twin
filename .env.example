# Takht-i-Bahi AI Digital Twin — Environment Configuration Example
# Copy this file to .env if you are configuring optional backend services or custom ports.
# The current app is fully static and needs no environment variables to run.

# Server Configuration (Optional)
PORT=8000
HOST=localhost

# Optional (planned): Gemini / LLM API key for a future Conversational AI Monk.
# Not used by the current build. Never commit a real key.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: TTS Service Configuration (edge-tts / gtts)
TTS_ENGINE=edge
DEFAULT_NARRATION_VOICE=male
